# FlowPilot Environment Configuration Example

# Server listening port
PORT=5000

# Gemini generative AI configuration
GEMINI_API_KEY=your_gemini_api_key_here

# JWT authentication security secret
JWT_SECRET=your_jwt_signing_secret_here

# Resend API key for real reminders delivery (Optional, falls back to simulated/mock logs if absent)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender email coordinates
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=FlowPilot
